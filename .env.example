# Resend API key used by app/api/contact/route.ts to send contact-form emails.
# Get one at https://resend.com/api-keys
RESEND_API_KEY=

# Where contact-form messages are delivered. Defaults to filibertosanudo@gmail.com
# in code if unset — override here once a custom-domain inbox exists.
CONTACT_EMAIL=filibertosanudo@gmail.com
